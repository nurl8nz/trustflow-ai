# Copy this file to .env and fill in the values. Never commit .env.

# PayPal Developer Dashboard > Apps & Credentials (Sandbox) > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Google AI Studio > Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: email of your sandbox Personal (buyer) account.
# Prefills the client email so PayPal can send invoices to it.
DEMO_CLIENT_EMAIL=

# Optional: webhook id from your app's Webhooks section (see README).
PAYPAL_WEBHOOK_ID=

# Optional
# PORT=3000
# PUBLIC_URL=https://your-app.onrender.com
# AI_CALLS_PER_HOUR=60
